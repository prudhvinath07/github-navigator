# Any LiteLLM model string: https://docs.litellm.ai/docs/providers
# OpenRouter: "openrouter/" + any model id from https://openrouter.ai/models
LLM_MODEL=openrouter/nvidia/nemotron-3.5-lightning:free

# Thinking: on / off, or an effort level: minimal, low, medium, high, xhigh, max
# (unset = the model's default)
LLM_REASONING=on

# Set the key for your provider using its standard variable...
OPENROUTER_API_KEY=
# GEMINI_API_KEY=        (with LLM_MODEL=gemini/gemini-2.5-flash)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ...or set a generic key / base URL (e.g. for an OpenAI-compatible router like Requesty):
# LLM_MODEL=openai/google/gemini-2.5-flash
# LLM_API_BASE=https://router.requesty.ai/v1
# LLM_API_KEY=

# Optional: override the model's context window used for truncation
# LLM_CONTEXT_TOKENS=200000

# Optional: GitHub token for private repos / higher rate limits
# GITHUB_TOKEN=
