# Google Gemini API Key (primary) - Get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=""

# OpenRouter API Key (fallback) - Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# OpenRouter Site Configuration (Optional)
OPENROUTER_SITE_URL="https://github-navigator.local"
OPENROUTER_SITE_NAME="GitHub Navigator"

# Flask Secret Key (for session encryption)
SECRET_KEY="change-me-to-a-random-string"

# Port for the web server (default: 8080)
PORT=8080

# Set to "true" to run Flask dev server instead of waitress
FLASK_DEBUG=false
